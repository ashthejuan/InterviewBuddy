# InterviewBuddy — env template (safe to commit)
# Copy to `.env` and fill in secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Seed / e2e helper id (sessions are owned by the Auth.js JWT subject)
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# -----------------------------------------------------------------------------
# Auth.js (Next.js) — email + password + GitHub OAuth
# Generate: openssl rand -base64 32
# Shared secret: Auth.js session cookie + FastAPI Bearer API tokens (HS256).
# GitHub OAuth App callback: {AUTH_URL}/api/auth/callback/github
# Next.js only auto-loads `frontend/.env*`. After setting these in root `.env`, also:
#   grep -E '^(AUTH_SECRET|AUTH_URL|DATABASE_URL|AUTH_GITHUB_ID|AUTH_GITHUB_SECRET)=' .env > frontend/.env.local
# then restart `npm run dev`.
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# -----------------------------------------------------------------------------
# Postgres + pgvector
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interviewbuddy
POSTGRES_USER=interviewbuddy
POSTGRES_PASSWORD=interviewbuddy
DATABASE_URL=postgresql+asyncpg://interviewbuddy:interviewbuddy@localhost:5432/interviewbuddy

# -----------------------------------------------------------------------------
# Redis (optional — live session state; leave blank to use in-memory)
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible). Local MinIO defaults below (docker compose).
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=interviewbuddy-docs
R2_ENDPOINT_URL=http://localhost:9000
R2_PUBLIC_BASE_URL=http://localhost:9000/interviewbuddy-docs
R2_REGION=auto

# -----------------------------------------------------------------------------
# OpenRouter (grill, scoring, report prose, claims)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Single model used for grill, claims, score, and report
DEFAULT_GRILL_MODEL=qwen/qwen3.7-flash
# auto | heuristic | openrouter — auto uses OpenRouter when key + DEFAULT_GRILL_MODEL set
CLAIMS_BACKEND=auto
# auto | stub | openrouter — auto uses OpenRouter when key + DEFAULT_GRILL_MODEL set
GRILL_BACKEND=auto
# auto | heuristic | openrouter — rubric scorer; auto uses OpenRouter when key + DEFAULT_GRILL_MODEL set
# (heuristic = deterministic, low-confidence fallback; also used when the LLM call fails)
SCORE_BACKEND=auto
# auto | heuristic | openrouter — post-interview report prose; same auto/fallback rules as SCORE_BACKEND
REPORT_BACKEND=auto

# -----------------------------------------------------------------------------
# Embeddings (local FastEmbed — no API key)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMS=384

# -----------------------------------------------------------------------------
# Sarvam (STT Saaras + TTS Bulbul)
# -----------------------------------------------------------------------------
SARVAM_API_KEY=
# saaras:v4 (default) | saaras:v3-realtime (realtime API; sends session lexicon as keyterm prompt)
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
# Optional Bulbul voice. Blank = simran_en_conversation on bulbul:v4*, plugin default otherwise.
# Speakers are model-specific (v4 uses names like dev_en_conversational; v2/v3 use anushka/shubh).
SARVAM_TTS_SPEAKER=
SARVAM_LANGUAGE=en-IN

# -----------------------------------------------------------------------------
# LiveKit — Cloud (wss://<project>.livekit.cloud) or local dev server:
#   docker compose --profile voice up -d livekit  → ws://localhost:7880, devkey / secret
# Voice is disabled in the UI until all three are set.
# -----------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Dispatch name the worker registers under; token requests target it
LIVEKIT_AGENT_NAME=interviewbuddy-grill
LIVEKIT_TOKEN_TTL_SECONDS=600

# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_PASTE_CHARS=100000

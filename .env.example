# InterviewBuddy — env template (safe to commit)
# Copy to `.env` and fill in secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Dev-only stub until auth is wired (Phase 7)
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# -----------------------------------------------------------------------------
# Postgres + pgvector
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interviewbuddy
POSTGRES_USER=interviewbuddy
POSTGRES_PASSWORD=interviewbuddy
DATABASE_URL=postgresql+asyncpg://interviewbuddy:interviewbuddy@localhost:5432/interviewbuddy

# -----------------------------------------------------------------------------
# Redis (optional — live session state; leave blank to use in-memory)
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible). For local MinIO, point endpoint at MinIO.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=interviewbuddy-docs
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# -----------------------------------------------------------------------------
# OpenRouter (grill, scoring, report prose)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GRILL_MODEL=
OPENROUTER_SCORE_MODEL=
OPENROUTER_REPORT_MODEL=

# -----------------------------------------------------------------------------
# Embeddings (local FastEmbed — no API key)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMS=384

# -----------------------------------------------------------------------------
# Sarvam (STT Saaras + TTS Bulbul)
# -----------------------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul
SARVAM_LANGUAGE=en-IN

# -----------------------------------------------------------------------------
# LiveKit
# -----------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
